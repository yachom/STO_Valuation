# 카카오 REST API 키 (주소 검색·좌표→행정구역)
KAKAO_API_KEY=

# 도로명주소 Juso API 승인키 (건물관리번호 조회)
# https://business.juso.go.kr/jst/jstAddressApiList
JUSO_API_KEY=

# Naver Open API (search/datalab/papago 등이 공유)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 건축HUB 건축물대장정보 서비스 일반 인증키 (Decoding)
# https://www.hub.go.kr/portal/opn/tyb/idx-bdrg-ttlldr.do
BUILDING_HUB_API_KEY=

# 공공데이터포털 BEEC(건물에너지효율등급) 활용신청 키 — efficiency_pipeline
BEEC_API_KEY=

# 공공데이터포털 odcloud G-SEED(녹색건축인증현황) 활용신청 키 — gseed_pipeline
GSEED_API_KEY=

# 국토교통부 RTMS 아파트 매매 실거래가 OpenAPI 일반 인증키 (Decoding)
# https://www.data.go.kr/data/15057511/openapi.do
MOLIT_REAL_TRANSACTION_KEY=

# 국토교통부 RTMS 아파트 전월세 실거래가 OpenAPI 일반 인증키 (Decoding)
# https://www.data.go.kr/data/15058017/openapi.do
MOLIT_RENT_KEY=

# Anthropic Claude — 보고서 에이전트 단일 LLM 프로바이더
ANTHROPIC_API_KEY=


# Neo4j (로컬 docker-compose 기본값과 일치) — 부동산
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 음악저작권 전용 Neo4j (부동산과 분리 — docker compose neo4j-music, 포트 7688)
MUSIC_NEO4J_URI=bolt://localhost:7688
MUSIC_NEO4J_USER=neo4j
MUSIC_NEO4J_PASSWORD=

# LH 공공임대주택 공급정보 OpenAPI 일반 인증키
# https://www.data.go.kr/data/15084288/openapi.do
LH_PUBLIC_HOUSING_KEY=

# ─── 상가 부동산 평가용 데이터 (PR-13~16) ─────────────────────
# 국토교통부 RTMS 상업·업무용 부동산 실거래가 (Decoding)
# https://www.data.go.kr/data/15058038/openapi.do
MOLIT_NRG_TRADE_KEY=

# 한국부동산원 상업용부동산 임대동향조사 (분기 공실률·임대료·수익률)
# https://www.data.go.kr/data/15046094/openapi.do
REB_LEASE_MARKET_KEY=

# 국세청 사업자등록 통계 (행정구역·업종별 신규/폐업/생존)
# https://www.data.go.kr/data/15081808/openapi.do
NTS_BUSINESS_KEY=

# 서울 열린데이터광장 인증키 (지하철역·버스정류장 등)
# https://data.seoul.go.kr/
SEOUL_OPEN_DATA_KEY=

# Langfuse 클라우드 트레이싱 (선택). 키 모두 있어야 활성, 누락 시 silent skip.
# https://cloud.langfuse.com 에서 프로젝트 생성 후 키 발급.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Slack 알림 웹훅 (선택). 외부 API 오류를 두 채널로 통지(없으면 silent no-op).
#   - SLACK_WEBHOOK_API_LIMIT : 모든 외부 오류(비-2xx/예외)를 모으는 채널.
#   - SLACK_WEBHOOK_ALERTS    : 가시성 채널(오류 + 실행종료 요약).
# Slack > Apps > Incoming Webhooks에서 채널별 URL 발급해 .env(추적 안 됨)에만 넣을 것.
# ⚠️ 웹훅 URL은 사실상 시크릿 — 이 파일(.env.example)엔 실제 값을 절대 커밋하지 말 것.
SLACK_WEBHOOK_API_LIMIT=
SLACK_WEBHOOK_ALERTS=

DATA_GO_KR_API_KEY = 

TAVILY_API_KEY=

SPOTIFY_CLIENT_ID =
SPOTIFY_CLIENT_SECRET =

LASTFM_API_KEY =

# MusicBrainz — 키 아님, 앱 식별 문자열. 형식: "앱이름/버전 ( 연락처 )"
# (Wikidata 보강도 이 UA를 재사용한다 — Wikidata API가 식별 UA를 요구)
MUSICBRAINZ_USER_AGENT = "STO-Valuation/1.0 ( contact@example.com )"

# ─── 음악 정형 데이터 보강 (시더 _collect_structured) ─────────────
# 웹검색이 못 주는 차트·수상·권리·샘플/커버·소셜 지표를 식별자 기반 정형 소스에서 적재.
#
# Wikidata — 키 불필요(MUSICBRAINZ_USER_AGENT 재사용). 수상·노미네이트·레이블.
#   별도 키 없음. UA만 있으면 동작.
#
# Genius — 크레딧·프로듀서·샘플/인터폴레이션/커버·pageviews. 무료 발급.
#   https://genius.com/api-clients 에서 Client 생성 → "Client Access Token" 복사.
GENIUS_ACCESS_TOKEN=
#
# Soundcharts — 차트 순위 + 스트리밍/소셜 오디언스 시계열(집계, 유료).
#   https://soundcharts.com/api 문의로 발급. 샌드박스: 둘 다 "soundcharts".
#   헤더 x-app-id / x-api-key 로 전송.
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
#
# (한국 정형 소스 — 추후 커넥터 예정, 공식 API 없어 스크래핑 필요)
#   Circle Chart(구 Gaon) circlechart.kr — 국내 차트 순위
#   KOMCA(한국음악저작권협회) komca.or.kr — 작품/권리자 검색 (지속성 핵심)
# ──────────────────────────────────────────────────────────────
# LLM provider/모델 override (선택). 기본은 Claude 4.X (Anthropic).
# tier 단위로 .env에서 갈아끼울 수 있어 로컬 모델 전환이 환경변수만으로 가능.
#
# tier별: TIER_<TIER>_PROVIDER ∈ {anthropic | ollama | openai_compat}
#         TIER_<TIER>_MODEL    — 모델 ID (provider별 형식)
#         TIER_<TIER>_BASE_URL — 로컬 서버 URL (ollama/openai_compat)
#         TIER_<TIER>_MAX_TOKENS
#
# 예시 — Sonnet tier를 ollama llama3.1:70b로 전환:
#   TIER_SONNET_PROVIDER=ollama
#   TIER_SONNET_MODEL=llama3.1:70b-instruct
#   TIER_SONNET_BASE_URL=http://localhost:11434
#   TIER_SONNET_MAX_TOKENS=8000
#
# 예시 — vLLM(OpenAI 호환) 서버로 전환:
#   TIER_HAIKU_PROVIDER=openai_compat
#   TIER_HAIKU_MODEL=Qwen/Qwen2.5-7B-Instruct
#   TIER_HAIKU_BASE_URL=http://localhost:8000/v1
#   LOCAL_LLM_API_KEY=local
#
# 에이전트별 tier 변경: AGENT_TIER_<AGENT>=<tier>
# 예시 — tenant_analyst를 opus로 승격:
#   AGENT_TIER_TENANT_ANALYST=opus
# ──────────────────────────────────────────────────────────────