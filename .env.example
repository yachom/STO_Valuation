# --- Runtime ---
ENV=local              # local | dev | prod
LOG_LEVEL=INFO

# --- LLM providers (one or both) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- External APIs (commercial asset) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JUSO_API_KEY=
VWORLD_API_KEY=
MOLIT_API_KEY=
BUILDING_LEDGER_API_KEY=

# --- Per-role LLM override (optional; YAML is source of truth) ---
# LLM_PLANNER=claude-opus-4-7
# LLM_RETRIEVER=gpt-4o-mini
# LLM_CRITIC=claude-sonnet-4-6
