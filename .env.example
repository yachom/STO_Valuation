# Neo4j (로컬 docker-compose 기본값과 일치)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LH 공공임대주택 공급정보 OpenAPI 일반 인증키
