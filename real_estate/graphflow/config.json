{
  "_comment": "graphflow 중앙 튜닝 설정. 비밀(API키)은 .env. 우선순위: env override > 이 파일 > 코드 기본값. A/B 실험의 variant = 이 설정의 부분 override.",

  "models": {
    "tiers": {
      "opus":     {"provider": "anthropic", "model": "claude-opus-4-8",            "max_tokens": 8000},
      "sonnet":   {"provider": "anthropic", "model": "claude-sonnet-4-6",          "max_tokens": 8000},
      "haiku":    {"provider": "anthropic", "model": "claude-haiku-4-5-20251001",  "max_tokens": 4096},
      "gpt_mini": {"provider": "openai",    "model": "gpt-4o-mini",                "max_tokens": 4096}
    },
    "agents": {
      "navigator":    "haiku",
      "harvester":    "gpt_mini",
      "prefilter":    "gpt_mini",
      "curator":      "haiku",
      "walk_judge":   "haiku",
      "writer":       "sonnet",
      "synthesizer":  "opus",
      "auditor":      "sonnet",
      "reviser":      "sonnet",
      "qa":           "sonnet",
      "qa_recognize": "haiku",
      "moderator":    "haiku",
      "perspectivist": "sonnet",
      "questioner":   "haiku",
      "researcher":   "gpt_mini",
      "outliner":     "sonnet"
    }
  },

  "curation": {
    "mode": "static",
    "moderator_max_rounds": 2,
    "moderator_budget_per_round": 6,
    "moderator_max_questions": 3,
    "perspectives_max": 2,
    "turns_per_perspective": 2,
    "research_budget": 3
  },

  "retrieval": {
    "evidence_k":    12,
    "news_k":        2,
    "alpha":         0.6,
    "max_hops":      4,
    "semantic":      true,
    "corroboration": true,
    "corrob_beta":   0.35,
    "fact_reserve":  0
  },

  "expand": {
    "rounds":             2,
    "frontier_max":       12,
    "queries_per_node":   3,
    "total_query_budget": 100,
    "novelty_threshold":  0.1
  }
}
