{
  "_comment": "music_copyright graphflow 파이프라인 튜닝 — 축·검색·확장·큐레이션·QA. 모델은 models.json(공유), 프롬프트는 music_prompts.json. 우선순위: 이 파일 > 코드 기본값(music_copyright/graphflow/config.py:_DEFAULTS). web-search-first 자산이라 expand가 시드 역할도 한다(STUB). axes = 사회·문화가치형 3축.",

  "axes": ["influence", "popularity", "sustainability"],

  "curation": {
    "mode": "static",
    "moderator_max_rounds": 1,
    "moderator_budget_per_round": 2,
    "moderator_max_questions": 2,
    "perspectives_max": 2,
    "turns_per_perspective": 3,
    "research_budget": 2
  },

  "retrieval": {
    "evidence_k":    16,
    "news_k":        6,
    "alpha":         0.6,
    "max_hops":      4,
    "semantic":      true,
    "corroboration": true,
    "corrob_beta":   0.35,
    "fact_reserve":  0
  },

  "expand": {
    "rounds":             2,
    "frontier_max":       6,
    "queries_per_node":   2,
    "total_query_budget": 8,
    "novelty_threshold":  0.1
  },

  "qa": {
    "min_evidence":  2,
    "min_top_score": 0.12,
    "mini_expand":   {"rounds": 1, "frontier_max": 2, "total_query_budget": 3}
  }
}
