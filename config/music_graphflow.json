{
  "_comment": "music_copyright graphflow 파이프라인 튜닝 — 축·검색·확장·큐레이션·QA. 모델은 models.json(공유), 프롬프트는 music_prompts.json. 우선순위: 이 파일 > 코드 기본값(music_copyright/graphflow/config.py:_DEFAULTS). web-search-first 자산이라 expand가 시드 역할도 한다(STUB). axes = 자산가치 3축 + 사회적 가치 1축(이중 트랙).",

  "axes": ["influence", "popularity", "sustainability", "social_value"],

  "curation": {
    "mode": "static",
    "moderator_max_rounds": 3,
    "moderator_budget_per_round": 4,
    "moderator_max_questions": 3,
    "perspectives_max": 4,
    "turns_per_perspective": 3,
    "research_budget": 3,
    "total_research_query_budget": 80
  },

  "retrieval": {
    "evidence_k":    28,
    "news_k":        10,
    "alpha":         0.6,
    "max_hops":      5,
    "semantic":      true,
    "corroboration": true,
    "corrob_beta":   0.35,
    "fact_reserve":  0
  },

  "expand": {
    "rounds":             3,
    "frontier_max":       8,
    "queries_per_node":   2,
    "total_query_budget": 24,
    "novelty_threshold":  0.1,
    "min_query_utility":  0.18,
    "max_poor_rounds":    2
  },

  "consolidate": {
    "enabled":    true,
    "mode":       "rules_first",
    "min_conf":   0.6,
    "scope_hops": 4
  },

  "agentic_graph": {
    "enabled":    true,
    "mode":       "proposal_first",
    "min_conf":   0.72,
    "scope_hops": 4,
    "max_entities": 40,
    "facts_per_entity": 8,
    "max_proposals": 28,
    "auto_commit_edges": ["CHARTED_ON", "WON", "CERTIFIED", "HAS_FANDOM"]
  },

  "qa": {
    "min_evidence":  2,
    "min_top_score": 0.12,
    "mini_expand":   {"rounds": 1, "frontier_max": 2, "total_query_budget": 3},
    "post_write_gap_expand": {
      "enabled": true,
      "max_axes": 2,
      "rounds": 1,
      "frontier_max": 2,
      "total_query_budget": 3,
      "min_axis_facts": 4,
      "axis_overrides": {
        "social_value": {"rounds": 2, "total_query_budget": 8}
      }
    }
  }
}
